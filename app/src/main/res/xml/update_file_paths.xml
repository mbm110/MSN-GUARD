<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The updates/ entry is gone with the in-app APK installer: the updater no
         longer downloads a package, so nothing shares a URI out of cacheDir/updates. -->
    <!-- Needed by the logs screen's SHARE button, which writes the full log to
         cacheDir/logs. Without this entry FileProvider.getUriForFile throws
         IllegalArgumentException and the share silently fails. -->
    <cache-path name="logs" path="logs/" />
</paths>
