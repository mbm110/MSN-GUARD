<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      FOREGROUND_SERVICE_SPECIAL_USE, not ..._DATA_SYNC. A dataSync foreground
      service is capped at 6 hours per 24 on Android 15+ (targetSdk 36 here):
      the system calls Service.onTimeout() and then kills the process if the
      service has not stopped itself. A tunnel that dies after 6 hours is the
      "app goes to sleep in the background" report, and exempting the app from
      battery optimisation does NOT lift that cap — the timeout is by design.
      specialUse carries no runtime timeout. It is also what every upstream VPN
      settled on after hitting the same crash (Orbot #1263, v2rayNG, WG Tunnel);
      systemExempted was rejected because it throws when no VPN is active yet,
      which is exactly the state we are in while connecting.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ACCESS_NETWORK_STATE: LAN sharing asks ConnectivityManager which interfaces
         belong to a cellular or VPN network, so it can refuse to advertise an
         address no LAN client can reach. Without it the query throws
         SecurityException and CoreConfig falls back to matching interface-name
         prefixes, which is a guess rather than an answer. Read-only, and it is one
         of the permissions Play Protect does not treat as sensitive. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- REQUEST_INSTALL_PACKAGES is intentionally absent. The updater used to
         download an APK and drive the package installer, which needs this
         permission and is the static signature Play Protect and the OEM scanners
         flag as dropper behaviour. Updates now open in the browser instead, so
         neither the permission nor the runtime download exists. Do not add it
         back without re-reading the AppUpdater header comment. -->

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
       </intent>
   </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="MSN-GUARD"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.MsnGuard">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.MsnGuard.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Upstream v0.8.0 gain: Android TV / leanback launcher support.
                     Harmless on phones, and there is no reason to drop it. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!--
              Long-pressing the Quick Settings tile lands here.
              Android looks for an activity with this action; when nothing declares
              it, it falls back to the system App Info page — which is exactly what
              a user reported ("holding the tile opens the app's system settings").
              Declaring it on MainActivity makes long-press open the app.
            -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The user-config screen (paste / edit / ping V2Ray-family links).
          Its own activity rather than a page inside MainActivity, which already
          hosts eleven in-place pages. portrait + the same configChanges as
          MainActivity so a rotation cannot rebuild it mid-edit and lose the
          user's half-typed config.
        -->
        <activity
            android:name=".ConfigsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MsnGuard" />

        <!--
          Invisible helper whose only job is to let the QS tile collapse the shade.
          Own taskAffinity so it never stacks on top of MainActivity; noHistory +
          excludeFromRecents so it leaves no trace in recents.
        -->
        <activity
            android:name=".ShadeCollapseActivity"
            android:exported="false"
            android:theme="@style/Theme.MsnGuard.Invisible"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance" />

        <service
            android:name=".MsnGuardVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <!--
              Declared subtype is required by Play review for specialUse; it has
              no effect at runtime, but leaving it out gets the upload rejected.
            -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_tunnel" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
           </intent-filter>
       </service>

        <service
            android:name=".MsnGuardTileService"
            android:icon="@drawable/ic_notification"
            android:label="@string/vpn_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
           </intent-filter>
       </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
       </provider>
   </application>
</manifest>
